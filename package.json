{
  "name": "@electerm/updater",
  "version": "0.1.0",
  "description": "Install a matching Electerm desktop release",
  "license": "MIT",
  "bin": {
    "electerm-updater": "src/index.js"
  },
  "dependencies": {
    "axios": "1.20.0",
    "https-proxy-agent": "7.0.1",
    "socks-proxy-agent": "8.0.1",
    "tar": "7.5.22"
  },
  "main": "./src/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electerm/electerm-updater.git"
  },
  "homepage": "https://github.com/electerm/electerm-updater#readme",
  "bugs": {
    "url": "https://github.com/electerm/electerm-updater/issues"
  },
  "author": "electerm",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --test test/updater.test.cjs",
    "pack:check": "npm pack --dry-run"
  },
  "files": [
    "src",
    "README.cn.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.js",
    "./index": "./src/index.js",
    "./index.js": "./src/index.js",
    "./release": "./src/release.js",
    "./release.js": "./src/release.js",
    "./install.sh": "./src/install.sh",
    "./install.ps1": "./src/install.ps1",
    "./package.json": "./package.json",
    "./README.md": "./README.md",
    "./README.cn.md": "./README.cn.md",
    "./LICENSE": "./LICENSE"
  }
}
